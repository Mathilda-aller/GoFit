# Alibaba Cloud Model Studio / DashScope. Do not commit the real .env file.
# The AI backend uses one DashScope account and one API key.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com

GOFIT_ASR_MODEL=qwen3-asr-flash
GOFIT_OCR_MODEL=qwen3.5-ocr
GOFIT_VISION_MODEL=qwen3.6-plus
GOFIT_ACTION_CARD_MODEL=qwen-flash

GOFIT_ACTION_CARD_PROVIDER=dashscope

# Advanced overrides only when a workspace or regional endpoint differs from the default.
# DASHSCOPE_COMPATIBLE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_NATIVE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# GOFIT_PEER_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

GOFIT_FFMPEG_PATH=ffmpeg
GOFIT_FFPROBE_PATH=ffprobe
GOFIT_MEDIA_OUTPUT_DIR=../../storage/ai-generated
GOFIT_FRAME_INTERVAL_SECONDS=2.0
GOFIT_MAX_FRAMES=24
GOFIT_MODEL_TIMEOUT_SECONDS=120
GOFIT_USE_JSON_RESPONSE_FORMAT=true
